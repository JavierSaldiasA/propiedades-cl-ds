# Conexión a Supabase Postgres
# (Dashboard de Supabase → Settings → Database → Connection string)
URL_DATABASE=postgresql://usuario:password@host:5432/postgres

# API Banco Central de Chile (valor UF)
# Registro gratuito en https://si3.bcentral.cl/estadisticas/Principal1/web_services/index.htm
USUARIO_BCCH=tu_usuario
PASSWORD_BCCH=tu_password
